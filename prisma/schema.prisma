generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Event {
  id          String        @id @default(cuid())
  title       String
  location    String?
  description String?
  category    EventCategory
  isTimeout   Boolean       @default(false)
  start       DateTime      @db.Timestamptz(3)
  end         DateTime      @db.Timestamptz(3)
  allDay      Boolean       @default(false)
  status      EventStatus   @default(DRAFT)

  // Relations
  includedGroups Group[]  @relation("EventGroups")
  records        Record[]
  attendanceChanges AttendanceChange[]

  createdById     String?
  createdBy       User?     @relation("EventCreator", fields: [createdById], references: [id])
  reviewedById    String?
  reviewedBy      User?     @relation("EventReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime? @db.Timestamptz(3)
  rejectionReason String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([status])
  @@index([createdById])
  // The common list query filters by status and orders by start; the composite
  // lets the index satisfy both and drop the temp B-tree sort.
  @@index([status, start])
}

model Student {
  id          String      @id
  lastName    String
  firstName   String
  middleName  String?
  yearLevel   YearLevel
  schoolLevel SchoolLevel

  // Relations: Students can belong to multiple groups (House, Strand, etc.)
  groups  Group[]
  records Record[]
  attendanceChanges AttendanceChange[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  // Roster sort modes, so the common orderings don't need a temp B-tree.
  // Group-membership filtering goes through the Group relation, so it is not
  // indexed here; that belongs on the join table if it ever needs tuning.
  @@index([updatedAt, id])
  @@index([lastName, firstName, id])
  @@index([schoolLevel, yearLevel, lastName, firstName, id])
}

model Record {
  id        String           @id @default(cuid())
  eventId   String
  event     Event            @relation(fields: [eventId], references: [id])
  studentId String
  student   Student          @relation(fields: [studentId], references: [id])
  method    AttendanceMethod
  timein    DateTime?        @db.Timestamptz(3)
  timeout   DateTime?        @db.Timestamptz(3)
  revision  Int              @default(0)

  // Audit trail: who created the record and who last touched it
  recordedById     String?
  recordedBy       User?   @relation("RecordCreator", fields: [recordedById], references: [id])
  lastModifiedById String?
  lastModifiedBy   User?   @relation("RecordModifier", fields: [lastModifiedById], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([eventId, studentId])
}

model AttendanceChange {
  id             BigInt   @id @default(autoincrement())
  eventId        String
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  recordId       String
  action         AttendanceChangeAction
  actorId        String?
  actorName      String?
  eventTitle     String
  studentLabel   String
  reason         String?
  before         Json?    @db.JsonB
  after          Json?    @db.JsonB
  commandId      String?
  commandHash    String?
  sourceChangeId BigInt?
  sourceChange   AttendanceChange? @relation("RestoredFromVoid", fields: [sourceChangeId], references: [id], onDelete: Restrict)
  restorations   AttendanceChange[] @relation("RestoredFromVoid")
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@unique([actorId, commandId])
  @@index([eventId, studentId, id])
  @@index([eventId, id])
  @@index([studentId, id])
  @@index([recordId])
}

model User {
  id              String     @id @default(cuid())
  name            String
  role            UserRole   @default(ORGANIZER)
  email           String     @unique
  password        String
  status          UserStatus @default(PENDING)
  rejectionReason String?
  // Set when an admin issues a temporary password; cleared once the user
  // picks their own. Gates the app shell until then.
  mustChangePassword Boolean @default(false)
  // Increments on every credential change (reset, replacement, local
  // recovery). Mirrored inside the signed cookie so a reset revokes
  // previously issued cookies at the next server session check.
  credentialVersion Int @default(0)
  createdEvents   Event[]    @relation("EventCreator")
  reviewedEvents  Event[]    @relation("EventReviewer")
  createdRecords  Record[]   @relation("RecordCreator")
  modifiedRecords Record[]   @relation("RecordModifier")

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model Group {
  id       String        @id @default(cuid())
  name     String
  slug     String        @unique
  category EventCategory

  // Relations
  students Student[]
  events   Event[]   @relation("EventGroups")

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([category])
}

enum UserRole {
  ORGANIZER
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum EventStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum AttendanceMethod {
  MANUAL
  SCANNED
}

enum AttendanceChangeAction {
  CREATE
  TIME_IN
  TIME_OUT
  CORRECT
  VOID
  RESTORE
}

enum YearLevel {
  YEAR_1
  YEAR_2
  YEAR_3
  YEAR_4
  GRADE_11
  GRADE_12
}

enum SchoolLevel {
  SHS
  COLLEGE
}

enum EventCategory {
  ALL
  COLLEGE
  SHS
  DEPARTMENT
  HOUSE
  STRAND
  PROGRAM
  SECTION
  YEAR
}
