# PostgreSQL is the only runtime/development/integration-test provider.
# SQLite/file: URLs are refused everywhere — there is no fallback.
#
# Local development (same server/database for both roles is allowed locally):
#   DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/event_attendance_dev"
#   DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5433/event_attendance_dev"
#   TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres"
#   AUTH_SECRET="<random string, 16+ chars>"
#
# Production (separate roles/endpoints, verified TLS):
#   DATABASE_URL="<runtime role, pooled, verify-full>"
#   DIRECT_URL="<migration role, direct non-pooled, verify-full>"
#   AUTH_SECRET="<strong secret, rotated at cutover>"
# Never expose connection strings, passwords, hostnames or CA material in UI,
# logs, artifacts or command arguments.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/event_attendance_dev"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5433/event_attendance_dev"
TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres"
AUTH_SECRET="change-me-to-at-least-16-chars"
