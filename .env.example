# PostgreSQL is the only runtime/development/integration-test provider.
# SQLite/file: URLs are refused everywhere — there is no fallback.
#
# Local development (same server/database for both roles is allowed locally):
#   DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/event_attendance_dev"
#   DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5433/event_attendance_dev"
#   TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres"
#   AUTH_SECRET="<random string, 16+ chars>"
#
# Production (separate roles/endpoints, verified TLS):
#   DATABASE_URL="<runtime role, pooled, verify-full>"
#   DIRECT_URL="<migration role, direct non-pooled, verify-full>"
#   AUTH_SECRET="<strong secret, rotated at cutover>"
# Never expose connection strings, passwords, hostnames or CA material in UI,
# logs, artifacts or command arguments.
#
# Backups (#84) — PostgreSQL-native logical backups with a controlled runner.
# BACKUP_DIR is private runner storage (0700): catalog, spool, locks,
# artifacts, manifests. Production must set an explicit restricted directory;
# the default ./backups is a local-dev convenience, never a durability claim.
# BACKUP_SOURCE_LABEL is the approved display label (never a URL).
# BACKUP_PG_DUMP_PATH / BACKUP_PG_RESTORE_PATH override version-matched tools
# when PATH does not resolve the server major (e.g. docker-exec wrappers).
# BACKUP_SECONDARY_DIR + _LABEL configure the independent second destination;
# whether it is a separate failure domain is BACKUP_FAILURE_DOMAIN_NOTE, an
# operator assertion — never inferred from a different folder path.
# Provider PITR is BACKUP_PROVIDER_* evidence only when verified; absent means
# not configured / not verified. Retention prunes only when
# BACKUP_RETENTION_CONFIRMED=true, and never the last good artifact.
# BACKUP_SCHEDULE_DESC / _TIMEZONE / _RUNNER_OWNERSHIP record the deployment
# timer that invokes `pnpm backup:run -- --scheduled` (every 15 min in event
# operations, daily otherwise). See the operator runbook §1.
# BACKUP_DIR="./backups"
# BACKUP_SOURCE_LABEL="School attendance"
# BACKUP_SECONDARY_DIR=""
# BACKUP_SECONDARY_LABEL=""
# BACKUP_FAILURE_DOMAIN_NOTE=""
# BACKUP_RETENTION_CONFIRMED="false"
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/event_attendance_dev"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5433/event_attendance_dev"
TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres"
AUTH_SECRET="change-me-to-at-least-16-chars"
